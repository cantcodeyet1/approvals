PORT=4000

# Supabase project settings -> API (Project Settings -> API Keys)
SUPABASE_URL=https://<project-ref>.supabase.co
# "Secret key" (sb_secret_...) — the service_role equivalent. Server-side only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
